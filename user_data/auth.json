{
  "// ===== 交易所配置 ===== ": "注释：交易所连接和交易对设置",
  "exchange": {
    "name": "okx",
    "key": "",
    "secret": "",
    "passphrase": "",
    "password": "",
    "uid": "",
    "wallet_address": "",
    "private_key": "",
    "rsa_private_key": ""
  },

  "// ===== API服务器 ===== ": "注释：REST API配置",
  "bot_name": "dynamicgrid",
  "api_server": {
    "enabled": true,
    "enable_openapi": false,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "jwt_secret_key": "",
    "ws_token": "",
    "username": "",
    "password": "",
    "CORS_origins": [
      "http://127.0.0.1:8080",
      "http://localhost:8080"
    ]
  },

  "webhook": {
    "enabled": true,
    "url": "http://backend:8000/api/v1/signals/webhook",
    "format": "json",
    "retries": 3,
    "retry_delay": 1.0,
    "timeout": 10,
    "entry_fill": {
      "instance_id": "{instance_id}",
      "webhook_secret": "{webhook_secret}",
      "type": "{type}",
      "trade_id": "{trade_id}",
      "exchange": "{exchange}",
      "pair": "{pair}",
      "direction": "{direction}",
      "order_type": "{order_type}",
      "open_rate": "{open_rate:.8f}",
      "stake_amount": "{stake_amount:.8f}",
      "amount": "{amount:.8f}",
      "stake_currency": "{stake_currency}",
      "base_currency": "{base_currency}",
      "quote_currency": "{quote_currency}",
      "fiat_currency": "{fiat_currency}",
      "leverage": "{leverage}",
      "enter_tag": "{enter_tag}",
      "open_date": "{open_date}",
      "sub_trade": "{sub_trade}",
      "current_rate": "{current_rate}",
      "order_rate": "{order_rate:.8f}"
    },
    "exit_fill": {
      "instance_id": "{instance_id}",
      "webhook_secret": "{webhook_secret}",
      "type": "{type}",
      "trade_id": "{trade_id}",
      "exchange": "{exchange}",
      "pair": "{pair}",
      "direction": "{direction}",
      "order_type": "{order_type}",
      "close_rate": "{close_rate:.8f}",
      "profit_amount": "{profit_amount:.8f}",
      "profit_ratio": "{profit_ratio:.8f}",
      "stake_amount": "{stake_amount:.8f}",
      "amount": "{amount:.8f}",
      "stake_currency": "{stake_currency}",
      "base_currency": "{base_currency}",
      "quote_currency": "{quote_currency}",
      "fiat_currency": "{fiat_currency}",
      "leverage": "{leverage}",
      "enter_tag": "{enter_tag}",
      "exit_reason": "{exit_reason}",
      "open_date": "{open_date}",
      "close_date": "{close_date}",
      "sub_trade": "{sub_trade}",
      "cumulative_profit": "{cumulative_profit}",
      "final_profit_ratio": "{final_profit_ratio}",
      "is_final_exit": "{is_final_exit}",
      "gain": "{gain}",
      "open_rate": "{open_rate:.8f}",
      "current_rate": "{current_rate}",
      "order_rate": "{order_rate:.8f}"
    }
  }
}